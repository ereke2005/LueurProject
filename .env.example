# Copie ces variables dans le dashboard Render (Environment),
# ne les commite jamais dans le dépôt Git.

SECRET_KEY=change-moi
DEBUG=False

# Clé API Voiceflow (Integrations > Dialog API > Copy API Key)
# Reste 100% côté serveur, jamais envoyée au navigateur.
VF_API_KEY=VF.DM.xxxxxxxx

# Version à interroger (laisser "production" en général)
VF_VERSION_ID=production
